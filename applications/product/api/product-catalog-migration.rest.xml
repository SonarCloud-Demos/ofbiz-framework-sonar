<api name="Product Catalog Migration API"
        path="product-catalog-migration"
        displayName="Product Catalog Migration"
        description="Temporary read-only adapter for the catalog migration"
        publish="true">
    <resource name="CatalogMigration" path="" auth="true" publish="true">
        <operation verb="get" path="/products" produces="application/json" auth="true"
                description="Read the canonical product projection from OFBiz">
            <service name="findProductsForCatalogMigration"/>
        </operation>
    </resource>
</api>
