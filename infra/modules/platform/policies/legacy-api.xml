<policies>
  <inbound>
    <base />
    <validate-jwt header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Authentication required" require-expiration-time="true" require-scheme="Bearer" output-token-variable-name="validated-token">
      <openid-config url="https://login.microsoftonline.com/${tenant_id}/v2.0/.well-known/openid-configuration" />
      <audiences><audience>${api_audience}</audience></audiences>
    </validate-jwt>
    <set-header name="X-Legacy-Identity" exists-action="delete" />
    <set-header name="X-Legacy-Permissions" exists-action="delete" />
    <set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
    <set-header name="X-Authenticated-Subject" exists-action="override">
      <value>@(((Jwt)context.Variables["validated-token"]).Subject)</value>
    </set-header>
    <set-header name="X-Authenticated-Tenant" exists-action="override">
      <value>@(((Jwt)context.Variables["validated-token"]).Claims.GetValueOrDefault("tid", ""))</value>
    </set-header>
    <set-header name="X-Catalog-Pilot-Route" exists-action="override"><value>legacy</value></set-header>
    <choose>
      <when condition="@(bool.Parse(&quot;${catalog_pilot_enabled}&quot;) &amp;&amp; &quot;${catalog_pilot_subjects}&quot;.Split(',').Contains(((Jwt)context.Variables[&quot;validated-token&quot;]).Subject))">
        <set-backend-service base-url="${modern_shell_origin_url}" />
        <rewrite-uri template="/catalog/products" />
        <set-header name="X-Catalog-Pilot-Route" exists-action="override"><value>modern</value></set-header>
      </when>
    </choose>
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error>
    <set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
    <base />
  </on-error>
</policies>
