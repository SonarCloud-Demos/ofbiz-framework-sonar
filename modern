#!/bin/sh
set -eu

command_name=${1:-help}
shift || true

case "$command_name" in
  build)
    exec ./gradlew build "$@"
    ;;
  test)
    ./gradlew :services:reference-service:test :services:experience-bff:test "$@"
    exec npm --prefix web/shell test
    ;;
  up)
    local-dev/generate-local-tls.sh
    ./gradlew :services:reference-service:installDist :services:product-catalog-service:installDist :services:experience-bff:installDist
    exec docker compose --env-file local-dev/.env -f local-dev/compose.yaml --profile legacy up --build --detach "$@"
    ;;
  smoke)
    exec local-dev/smoke-test.sh "$@"
    ;;
  down)
    exec docker compose --env-file local-dev/.env -f local-dev/compose.yaml --profile legacy down "$@"
    ;;
  reset)
    printf '%s' 'Remove local Phase 1 containers and volumes? [y/N] '
    read -r answer
    case "$answer" in
      y|Y|yes|YES)
        exec docker compose --env-file local-dev/.env -f local-dev/compose.yaml --profile legacy down --volumes --remove-orphans
        ;;
      *)
        printf '%s\n' 'Reset cancelled.'
        ;;
    esac
    ;;
  help|--help|-h)
    printf '%s\n' 'Usage: ./modern {build|test|up|smoke|down|reset}'
    ;;
  *)
    printf 'Unknown command: %s\n' "$command_name" >&2
    exit 2
    ;;
esac
