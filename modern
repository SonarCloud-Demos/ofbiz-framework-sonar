#!/bin/sh
set -eu

compose_file="local-dev/docker-compose.yml"
phase5_compose_file="local-dev/docker-compose.phase5.yml"

require_artifactory() {
  : "${ARTIFACTORY_GRADLE_PLUGIN_URL:?Set the approved Gradle plugin repository URL}"
  : "${ARTIFACTORY_MAVEN_URL:?Set the approved Maven repository URL}"
  : "${ARTIFACTORY_USER_FILE:?Set ARTIFACTORY_USER_FILE to a local secret file}"
  : "${ARTIFACTORY_TOKEN_FILE:?Set ARTIFACTORY_TOKEN_FILE to a local secret file}"
  test -r "${ARTIFACTORY_USER_FILE}"
  test -r "${ARTIFACTORY_TOKEN_FILE}"
}

case "${1:-help}" in
  build)
    require_artifactory
    ./gradlew --init-script "${PWD}/gradle/modern-artifactory.init.gradle" -p services/product-catalog-service clean bootJar
    ;;
  test)
    require_artifactory
    ./gradlew --init-script "${PWD}/gradle/modern-artifactory.init.gradle" -p services/product-catalog-service test
    sh -n local-dev/smoke-test.sh
    sh architecture/validate-phase4-routes.sh
    ;;
  start)
    docker compose -f "${compose_file}" up -d --build --wait
    ;;
  start-hybrid)
    test -r "${CATALOG_LEGACY_TOKEN_FILE:?Set CATALOG_LEGACY_TOKEN_FILE to the OFBiz REST token file}"
    docker compose -f "${compose_file}" -f "${phase5_compose_file}" up -d --build --wait
    ;;
  smoke)
    local-dev/smoke-test.sh
    ;;
  smoke-hybrid)
    PHASE5_EXPECT_LEGACY=true local-dev/smoke-test.sh
    ;;
  stop)
    docker compose -f "${compose_file}" down
    ;;
  clean)
    printf '%s\n' 'Refusing to delete local database data implicitly. Use docker compose down --volumes explicitly.'
    ;;
  *)
    printf '%s\n' 'Usage: ./modern {build|test|start|start-hybrid|smoke|smoke-hybrid|stop|clean}'
    ;;
esac
